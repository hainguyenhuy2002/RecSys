    "    formatted_prices = {}\n",
    "    for price in prices:\n",
    "        timestamp = price[0]\n",
    "        price_value = price[1]\n",
    "        formatted_prices[timestamp] = price_value\n",
    "    return formatted_prices\n"
   ]
